pipeline {
    agent any
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Install dependencies') { steps { sh 'python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt' } }
        stage('Test') { steps { sh '. .venv/bin/activate && pytest -q' } }
        stage('Build Docker image') { steps { sh 'docker build -t jenkins-cicd-demo:latest .' } }
        stage('Deploy') { steps { sh 'kubectl apply -f k8s/' } }
    }
}
